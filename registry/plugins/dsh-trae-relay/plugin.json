{
  "id": "dsh-trae-relay",
  "name": "Trae2api-dsh",
  "version": "1.3.0",
  "description": "TRAE CN relay and embedded console with daily check-in, multiple accounts, rotation, model discovery, reasoning levels and visibility controls. Automation is off by default; account/service permission is required. See the repository disclaimer.",
  "descriptionZh": "TRAE CN 反代与内嵌控制台，支持自动签到、多账号管理和轮询、模型发现、思考档位及模型显示/隐藏。自动签到与轮询默认关闭；仅限有权使用且服务方允许的账号与功能，详见仓库免责声明。",
  "author": {
    "name": "FuSheng-cs",
    "url": "https://github.com/FuSheng-cs"
  },
  "license": "MIT",
  "category": "integration",
  "tags": [
    "trae",
    "models",
    "relay",
    "accounts"
  ],
  "compatibility": {
    "dsh": "0.2.0-rc.2",
    "platforms": [
      "linux",
      "macos",
      "windows"
    ]
  },
  "install": {
    "target": "git",
    "spec": "github:FuSheng-cs/Trae2api-dsh#v1.3.0",
    "command": "dsh plugin --profile {profile} add github:FuSheng-cs/Trae2api-dsh#v1.3.0"
  },
  "verified": false,
  "maintainers": [
    "FuSheng-cs"
  ],
  "repository": "https://github.com/FuSheng-cs/Trae2api-dsh",
  "docs": "https://github.com/FuSheng-cs/Trae2api-dsh#readme",
  "screenshots": [
    "https://github.com/FuSheng-cs/Trae2api-dsh/raw/v1.3.0/assets/embedded-console.png",
    "https://github.com/FuSheng-cs/Trae2api-dsh/raw/v1.3.0/assets/model-catalog.png"
  ],
  "disclaimer": "https://github.com/FuSheng-cs/Trae2api-dsh/blob/v1.3.0/DISCLAIMER.md"
}
